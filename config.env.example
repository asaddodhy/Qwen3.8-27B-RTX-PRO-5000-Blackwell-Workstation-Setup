# Copy to config.env and adjust paths if needed.

SERVICE_NAME=qwen-vllm-mtp4
RUNTIME_DIR=/tmp/opencode/qwen-runtime
WORK_DIR=/tmp/opencode/qwen-bench
WORK_DIR_SOURCE="/home/dodhya/Documents/Default Project/qwen-bench"
MODEL_PATH="$WORK_DIR/models/Inferact-Qwen3.8-27B-NVFP4"
MODEL_REPO=Inferact/Qwen3.8-27B-NVFP4
MODEL_DOWNLOAD_DIR="/home/dodhya/Documents/Default Project/qwen-bench/models/Inferact-Qwen3.8-27B-NVFP4"

SERVED_MODEL_NAME=qwen3.8-27b
HOST=127.0.0.1
PORT=8000
# Required when HOST is not 127.0.0.1. Generate with: openssl rand -hex 32
API_KEY=
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=8
MTP_TOKENS=4
MAX_JOBS=2
ENGINE_READY_TIMEOUT=1800
